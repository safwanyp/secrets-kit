{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["generated/validate-config.js", ".release-please-manifest.json"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["import", "jsdoc", "promise", "unicorn", "vitest"]
}
