{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2024"
  },
  "include": [
    "generated/**/*.js",
    "scripts/**/*.js",
    "src/**/*.js",
    "test/**/*.js",
    "types/**/*.d.ts",
    "*.config.js"
  ]
}
